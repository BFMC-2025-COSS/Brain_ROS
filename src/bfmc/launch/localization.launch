<launch>
    <!-- Realsense IMU Publisher -->
    <node pkg="bfmc" type="realsense_publisher.py" name="realsense_publisher" output="screen"/>
    
    <!-- Serial Read (Speed) -->
    <node pkg="bfmc" type="serial_read.py" name="serial_read" output="screen"/>
    
    <!-- Initial Odometry Calculation -->
    <node pkg="bfmc" type="sync_initial_odo.py" name="initial_odo" output="screen"/>

    <!-- Serial Write -->
    <node pkg="bfmc" type="serial_write.py" name="serial_write" output="screen"/>

    <!-- Static Transform: map -> odom -->
    <node pkg="tf" type = "static_transform_publisher" name="map_to_odom" args="0 0 0 0 0 0 1 map odom 10"/>

    <!-- coss_localization -->
    <node pkg="bfmc" type="coss_localization.py" name="coss_localization" output="screen"/>

    <!-- EKF -->
    <node pkg="robot_localization" type="ekf_localization_node" name="ekf_localization_node" output="screen">
        <param name="use_sim_time" value="false"/>
        <param name="debug" value="false"/>
        <rosparam command="load" file="$(find bfmc)/config/ekf_fusion.yaml" />
    </node>
</launch>

