#!/usr/bin/env python3
"""
  * /odom            (Odometry)  : 고속 적분
  * /icp_pose        (Odometry)  : ICP가 계산한 map 좌표 pose
  이 두 토픽을 동기화 →  T_map_odom = P_icp ∘ P_odom^{-1}
  TF(map->odom) 브로드캐스트
"""
import rospy, tf, tf2_ros
from nav_msgs.msg import Odometry
import tf.transformations as tft

def mat_from_odom(od):
    q = [od.pose.pose.orientation.x,
         od.pose.pose.orientation.y,
         od.pose.pose.orientation.z,
         od.pose.pose.orientation.w]
    R = tft.quaternion_matrix(q)
    R[0,3] = od.pose.pose.position.x
    R[1,3] = od.pose.pose.position.y
    R[2,3] = od.pose.pose.position.z
    return R

class MapOdomTF:
    def __init__(self):
        self.br = tf.TransformBroadcaster()
        self.tf_buf = tf2_ros.Buffer(cache_time=rospy.Duration(10.0))
        self.tf_lst = tf2_ros.TransformListener(self.tf_buf)

        icp_sub = rospy.Subscriber("/localization/correctedOdom",
                                   Odometry, self.icp_cb, queue_size=10)

    def icp_cb(self, icp_msg):
        t = icp_msg.header.stamp
        try:
            # odom→base_link at same time
            od_tf = self.tf_buf.lookup_transform("odom", "base_link", t,
                                                 rospy.Duration(0.1))
        except (tf2_ros.LookupException,
                tf2_ros.ExtrapolationException):
            rospy.logwarn("odom TF not available at ICP time")
            return

        # ---- 행렬 변환 ----
        T_icp  = mat_from_odom(icp_msg)           # map→base
        T_odom = tft.concatenate_matrices(        # odom→base
                    tft.translation_matrix([od_tf.transform.translation.x,
                                             od_tf.transform.translation.y,
                                             od_tf.transform.translation.z]),
                    tft.quaternion_matrix([od_tf.transform.rotation.x,
                                           od_tf.transform.rotation.y,
                                           od_tf.transform.rotation.z,
                                           od_tf.transform.rotation.w]))

        T_map_odom = T_icp.dot(tft.inverse_matrix(T_odom))
        trans = T_map_odom[0:3,3]
        quat  = tft.quaternion_from_matrix(T_map_odom)
        self.br.sendTransform(trans, quat, t, "odom", "map")
